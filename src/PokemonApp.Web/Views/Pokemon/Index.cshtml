@model List<PokemonApp.Web.Models.ViewModels.PokemonListItemViewModel>

@{
    ViewData["Title"] = "Pokédex";
}

<h1 class="mb-4">Pokédex</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3" id="pokemon-grid">
    @foreach (var pokemon in Model)
    {
        <div class="col">
            <div class="card h-100 text-center">
                <img src="@pokemon.ImageUrl" class="card-img-top p-2" alt="@pokemon.Name"
                        style="height: 120px; object-fit: contain;"
                        onerror="this.src='/images/pokeball-placeholder.png';" />
                <div class="card-body p-2">
                    <p class="card-text text-capitalize mb-0">@pokemon.Name</p>
                </div>
            </div>
        </div>
    }
</div>