@model PokemonApp.Web.Models.ViewModels.PagedPokemonViewModel

@{
    ViewData["Title"] = "Pokédex";
}


<h1 class="mb-4">Pokédex</h1>
<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-auto">
        <input type="text" name="name" class="form-control" placeholder="Buscar por nombre..."
                value="@Model.Filters.NameFilter" />
    </div>
    <div class="col-auto">
        <select name="species" class="form-select">
            <option value="">Todas las especies</option>
            @foreach (var speciesName in Model.Filters.AvailableSpecies)
            {
                <option value="@speciesName" selected="@(speciesName == Model.Filters.SpeciesFilter)">
                    @speciesName
                </option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>
<div class="mb-3">
    <a class="btn btn-success btn-sm"
        asp-action="ExportExcel"
        asp-route-name="@Model.Filters.NameFilter"
        asp-route-species="@Model.Filters.SpeciesFilter"
        asp-route-page="@Model.CurrentPage">
        Exportar a Excel (página actual)
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3" id="pokemon-grid">
    @foreach (var pokemon in Model.Items)
    {
        <div class="col">
            <div class="card h-100 text-center pokemon-card" style="cursor: pointer;" data-pokemon-id="@pokemon.Id">
                <img src="@pokemon.ImageUrl" class="card-img-top p-2" alt="@pokemon.Name"
                        style="height: 120px; object-fit: contain;"
                        onerror="this.src='/images/pokeball-placeholder.png';" />
                <div class="card-body p-2">
                    <p class="card-text text-capitalize mb-0">@pokemon.Name</p>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Paginación de Pokémon" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-name="@Model.Filters.NameFilter" asp-route-species="@Model.Filters.SpeciesFilter">Anterior</a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">Página @Model.CurrentPage de @Model.TotalPages</span>
            </li>

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-name="@Model.Filters.NameFilter" asp-route-species="@Model.Filters.SpeciesFilter">Siguiente</a>
            </li>
        </ul>
    </nav>
    
}
<div class="modal fade" id="pokemonDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="pokemonDetailModalBody">
                <div class="text-center">Cargando...</div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/pokemon.js"></script>
}